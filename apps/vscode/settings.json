// settings.json — IntelliJ-style Vim leader mappings, no Which-Key
{
  // ========== CORE UI & EDITOR ==========
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "window.zoomLevel": 1,
  "git.enableSmartCommit": true,
  "workbench.sideBar.location": "left",
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "workbench.colorTheme": "Dark+",
  // External terminal
  "terminal.external.windowsExec": "C:\\\\Users\\\\Jazic\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\wt.exe",
  "terminal.integrated.defaultProfile.windows": "Windows Terminal",
  // Associations
  "files.associations": {
    "*.ps1": "powershell"
  },
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.zip": "default"
  },
  "chat.commandCenter.enabled": false,
  // ================= VIM (VSCodeVim) =================
  "vim.leader": " ",
  "vim.leaderModes": [
    "normal",
    "visual"
  ],
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.timeoutlen": 800,
  "vim.surround": true,
  // Insert-mode esc via jj/jk
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    },
    {
      "before": [
        "j",
        "k"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  // Visual-mode bindings
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "g",
        "c"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    },
    {
      "before": [
        "g",
        "C"
      ],
      "commands": [
        "editor.action.blockComment"
      ]
    }
  ],
  // Normal-mode bindings
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "Y"
      ],
      "after": [
        "y",
        "$"
      ]
    },
    // ===== LSP/Goto =====
    {
      "before": [
        "g",
        "d"
      ],
      "commands": [
        "editor.action.revealDefinition"
      ]
    },
    {
      "before": [
        "g",
        "D"
      ],
      "commands": [
        "editor.action.goToDeclaration"
      ]
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    },
    {
      "before": [
        "g",
        "I"
      ],
      "commands": [
        "editor.action.goToImplementation"
      ]
    },
    {
      "before": [
        "g",
        "y"
      ],
      "commands": [
        "editor.action.goToTypeDefinition"
      ]
    },
    {
      "before": [
        "g",
        "K"
      ],
      "commands": [
        "editor.action.showHover"
      ]
    },
    // Diagnostics next/prev ([[ / ]])
    {
      "before": [
        "]",
        "]"
      ],
      "commands": [
        "editor.action.marker.next"
      ]
    },
    {
      "before": [
        "[",
        "["
      ],
      "commands": [
        "editor.action.marker.prev"
      ]
    },
    // ===== Kommentare (gcc etc.) =====
    {
      "before": [
        "g",
        "c",
        "c"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    },
    // ===== Code Actions & Format =====
    {
      "before": [
        "<leader>",
        "c",
        "a"
      ],
      "commands": [
        "editor.action.refactor"
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "f"
      ],
      "commands": [
        "editor.action.formatDocument"
      ]
    },
    {
      "before": [
        "<leader>",
        "o",
        "i"
      ],
      "commands": [
        "editor.action.organizeImports"
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "c"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    },
    // ===== Window/Splits =====
    {
      "before": [
        "<leader>",
        "w",
        "v"
      ],
      "commands": [
        "workbench.action.splitEditorRight"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "h"
      ],
      "commands": [
        "workbench.action.splitEditorDown"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "w"
      ],
      "commands": [
        "workbench.action.unsplitEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "m"
      ],
      "commands": [
        "workbench.action.maximizeEditor"
      ]
    },
    // Move editor between groups
    {
      "before": [
        "<leader>",
        "e",
        "m"
      ],
      "commands": [
        "workbench.action.moveEditorToNextGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "e",
        "h"
      ],
      "commands": [
        "workbench.action.moveEditorToPreviousGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "l"
      ],
      "commands": [
        "workbench.action.moveEditorRightInGroup"
      ]
    },
    // ===== Buffers/Tabs =====
    {
      "before": [
        "<leader>",
        "b",
        "d"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "o"
      ],
      "commands": [
        "workbench.action.closeOtherEditors"
      ]
    },
    {
      "before": [
        "<leader>",
        ","
      ],
      "commands": [
        "workbench.action.showAllEditors"
      ]
    },
    // ===== Suche/Navigation =====
    {
      "before": [
        "<leader>",
        "<leader>"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "r"
      ],
      "commands": [
        "workbench.action.openRecent"
      ]
    },
    {
      "before": [
        "<leader>",
        "/"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "<leader>",
        "m",
        "f"
      ],
      "commands": [
        "workbench.action.gotoSymbol"
      ]
    },
    // ===== Explorer/Sidebar/Problems =====
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    {
      "before": [
        "<leader>",
        "p",
        "v"
      ],
      "commands": [
        "workbench.action.files.revealInExplorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "x",
        "l"
      ],
      "commands": [
        "workbench.actions.view.problems"
      ]
    },
    {
      "before": [
        "<leader>",
        "x",
        "q"
      ],
      "commands": [
        "workbench.actions.view.problems"
      ]
    },
    // ===== Terminal =====
    {
      "before": [
        "<leader>",
        "t",
        "n"
      ],
      "commands": [
        "workbench.action.terminal.newWithCwd"
      ],
      "args": {
        "cwd": "${fileDirname}"
      }
    },
    {
      "before": [
        "<leader>",
        "f",
        "t"
      ],
      "commands": [
        "workbench.action.terminal.focus"
      ]
    },
    // ===== Utility =====
    {
      "before": [
        "<leader>",
        "u",
        "r"
      ],
      "commands": [
        ":nohlsearch"
      ]
    }
  ],
  // REST Client envs
  "rest-client.environmentVariables": {
    "$shared": {},
    "$flexdev": {
      "host": "https://tbs-flexdev-01/"
    },
    "$local": {
      "host": "https://localhost/"
    }
  },
  "security.workspace.trust.untrustedFiles": "open",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://yazi-rs.github.io": {
      "approveRequest": false,
      "approveResponse": true
    }
  }
}
